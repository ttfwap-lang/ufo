# gx10 Telegram runner - environment template
# Copy to .env and fill in (NEVER commit the real .env - it is gitignored).
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Your numeric Telegram user id (owner-only access). Get it from @userinfobot.
OWNER_CHAT_ID=PASTE_YOUR_NUMERIC_CHAT_ID

# Local vLLM (default)
VLLM_URL=http://172.17.0.1:8000/v1
VLLM_MODEL=qwen-abliterated

# Or use Featherless's OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_MODEL=Qwen/Qwen3.8-Flash-Next
# LLM_API_KEY=
FEATHERLESS_API_KEY=

# Optional BrowserAct navigation arm
BROWSERACT_ENABLED=0
BROWSERACT_COMMAND_TIMEOUT_SECONDS=300
INSTALL_BROWSERACT=0
BROWSERACT_CLI=browser-act
# BROWSERACT_CLI_PATH=/usr/local/bin/browser-act
# BROWSERACT_BROWSER_ID=
# BROWSERACT_ALLOWED_DOMAINS=example.com,www.example.com
# BROWSERACT_REQUIRE_DOMAIN_ALLOWLIST=0
# BROWSERACT_SKILL_VERSION=2.0.2
BROWSERACT_API_KEY=
# BROWSERACT_ALLOW_STEALTH_EXTRACT=0

# Optional web fetch (disabled by default; public URLs only)
ALLOW_WEB=0
# UFO_WEB_ALLOWED_DOMAINS=example.com,www.example.com

# Windows UFO/Venus bridge
UFO_BRIDGE_URL=http://100.113.176.84:9301
UFO_BRIDGE_TOKEN_FILE=/app/ufo_bridge_token.txt
