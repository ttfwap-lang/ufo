# Copy to a local, ignored .env file. Never commit real values.
FEATHERLESS_API_KEY=
# Optional absolute path if `browser-act` is not on PATH:
# BROWSERACT_CLI_PATH=C:\Users\YOUR_USER\.local\bin\browser-act.exe
# Optional BrowserAct browser identity (one must already be configured):
# BROWSERACT_BROWSER_ID=
# Required only for BrowserAct stealth/remote features:
# BROWSERACT_API_KEY=
# Optional domain allowlist for the BrowserAct navigation arm:
# BROWSERACT_ALLOWED_DOMAINS=example.com,www.example.com
# Set to 1 in high-risk deployments to reject an empty allowlist:
# BROWSERACT_REQUIRE_DOMAIN_ALLOWLIST=1
# Keep private/local targets disabled unless explicitly needed:
# BROWSERACT_ALLOW_PRIVATE_NETWORKS=0
# Optional pinned BrowserAct skill compatibility version:
# BROWSERACT_SKILL_VERSION=2.0.2

# Optional standalone gx10 native-tool runner aliases:
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_MODEL=Qwen/Qwen3.8-Flash-Next
# LLM_API_KEY=
# BROWSERACT_ENABLED=0
# BROWSERACT_CLI_PATH=browser-act
# BROWSERACT_MAX_INPUT_CHARS=10000
# BROWSERACT_MAX_OUTPUT_CHARS=30000
# BROWSERACT_COMMAND_TIMEOUT_SECONDS=300
# BROWSERACT_ALLOW_STEALTH_EXTRACT=0
# ALLOW_WEB=0
