[Unit]
Description=Run the UFO watchdog every 2 minutes
Documentation=file:///home/flak3dd/ufo-watchdog/README.md

[Timer]
# 2 minutes: fast enough that a dead bridge is noticed before a user notices,
# slow enough to never be load. Persistent=true means a missed run (laptop
# asleep, reboot) is caught up immediately on resume.
OnBootSec=90s
OnUnitActiveSec=120s
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
