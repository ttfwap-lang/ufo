# UFO gitignore
# Ignore login file
*.bin

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints
/test/*
/testing/*
/deprecated/*
/test/*.ipynb
/logs/*
/customization/*
__pycache__/
**/__pycache__/
*.pyc
*.ipynb
/.VSCodeCounter
/analysis/*
/tla/*

# Ignore the config file
ufo/config/config.yaml
ufo/config/config_llm.yaml


# Ignore the helper files
ufo/rag/app_docs/*
learner/records.json
vectordb/docs/*
vectordb/experience/*
vectordb/demonstration/*

# Ignore the data files and scripts
tasks/*
scripts/*
backup/*
node_modules/*
.poolside/

# ...but DO track the gx10 deployment artifacts under scripts/: the systemd units, model
# launchers, budget and guard that define what runs on the box, and the Windows-side tunnel
# and host-resolution helpers. They were ignored by the blanket rule above, so they were never
# under version control and the copies on the box, in gx10_runner/ and in docs drifted apart.
!scripts/dgx/
!scripts/gx10_*.ps1
# ...and the gx10_*.py diagnostics. These are the tools that MEASURED the box
# (end-to-end latency/throughput, the read-only survey, and the per-ssh-client
# tunnel cost). A measurement that is not committed cannot be re-run when the
# next person suspects the tunnel is slow again - which is exactly the wrong
# time to be reconstructing it from a chat log.
!scripts/gx10_*.py
# fastwin.ps1: shared fast port/task helpers dot-sourced by the tracked watchers
# (bridge_watchdog.ps1, ufo_scan_win.ps1) - they break on a clean clone without it.
!scripts/fastwin.ps1
# Local environment file with API keys and passwords - never commit credentials
ufo.env
# verify_venus.py: asserts the gx10's grounding model actually INFERS, rather than
# merely answering /v1/models. It is the check that caught enable_thinking needing
# to travel in chat_template_kwargs for Qwen3-VL, which fails as a silently empty
# completion rather than an error - the kind of thing that reaches production
# unnoticed and is then very hard to see.
!scripts/verify_venus.py

# Don't ignore the example files
!vectordb/docs/example/
!vectordb/demonstration/example.yaml

.vscode
.idea/

# Ignore the record files
tasks_status.json
datas
_datas
datasUFO

.venv/*

# Ignore mkdocs build output
documents/site/

# Ignore frontend environment files with auto-generated content
galaxy/webui/frontend/.env.development.local

# Ignore config files with sensitive data (API keys)
config/*/agents.yaml
config/*/agent.yaml
ufo/config/config.yaml
ufo.env
*.env
ufo/config/config_llm.yaml

# But keep config templates and default configs (except agents.yaml and agent.yaml)
!config/*/*.template
!config/*/rag.yaml
!config/*/system.yaml
!config/*/mcp.yaml
!config/*/prices.yaml
!config/*/third_party.yaml
!config/*/device.yaml
!config/*/network.yaml
node_modules


# Vinv local artifacts (captures, index, reports)
.vinv/

config/*/backend_state.json

